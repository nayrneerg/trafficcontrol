{
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/insights",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "app/api/sync/[platform]/route.ts": {
      "maxDuration": 60
    },
    "app/api/insights/route.ts": {
      "maxDuration": 30
    }
  }
}
